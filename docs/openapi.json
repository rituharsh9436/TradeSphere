{
  "openapi": "3.1.0",
  "info": {
    "title": "Money-logix — Paper Trading API",
    "version": "1.0.0",
    "description": "REST API for the paper-trading engine. Every response uses the envelope `{ status, data, results? }`. Authenticated routes live under `/me` and require a JWT bearer token obtained from `/auth/register` or `/auth/login`. A push-only market tick stream is also available at `ws://localhost:5000/ws/market` (not described here). Full prose reference: docs/api.md."
  },
  "servers": [
    { "url": "http://localhost:5000/api", "description": "Local development" }
  ],
  "tags": [
    { "name": "Auth", "description": "Registration and login (public)" },
    { "name": "Me", "description": "Authenticated, token-scoped user resources" },
    { "name": "Market", "description": "Prices and candles (public)" },
    { "name": "Leaderboard", "description": "Rankings (public)" },
    { "name": "System", "description": "Health and API metadata" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Create an account (also provisions a $100,000 wallet) and return a token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify credentials and return a token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["Me"],
        "summary": "Get the authenticated user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": {
                      "type": "object",
                      "properties": { "user": { "$ref": "#/components/schemas/User" } }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/wallet": {
      "get": {
        "tags": ["Me"],
        "summary": "Get the authenticated user's wallet",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/positions": {
      "get": {
        "tags": ["Me"],
        "summary": "List open holdings valued at the latest price",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "results": { "type": "integer", "example": 1 },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Position" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/portfolio": {
      "get": {
        "tags": ["Me"],
        "summary": "Full portfolio valuation (cash + holdings, P/L, ROI)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/Portfolio" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/me/orders": {
      "get": {
        "tags": ["Me"],
        "summary": "List the authenticated user's orders (most recent first)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "results": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Order" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Me"],
        "summary": "Place a MARKET or LIMIT order",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlaceOrderRequest" },
              "examples": {
                "market": { "value": { "symbol": "AAPL", "side": "BUY", "quantity": 2 } },
                "limit": { "value": { "symbol": "AAPL", "side": "BUY", "quantity": 2, "orderType": "LIMIT", "targetPrice": "180.0000" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order placed (MARKET filled immediately; LIMIT rests as PENDING)",
            "content": {
              "application/json": {
                "schema": { "type": "object", "description": "MARKET returns the fill result; LIMIT returns { order }." }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/BusinessRule" }
        }
      }
    },
    "/me/orders/{id}": {
      "delete": {
        "tags": ["Me"],
        "summary": "Cancel one of the authenticated user's PENDING orders",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/Order" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/me/reset": {
      "post": {
        "tags": ["Me"],
        "summary": "Panic button: liquidate positions, cancel pending orders, restore wallet to $100,000",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/ResetSummary" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/market/prices": {
      "get": {
        "tags": ["Market"],
        "summary": "Latest price for every asset",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "results": { "type": "integer" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Price" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/market/prices/{symbol}": {
      "get": {
        "tags": ["Market"],
        "summary": "Latest price for a single symbol (data is null if unpriced)",
        "parameters": [
          { "name": "symbol", "in": "path", "required": true, "schema": { "type": "string" }, "example": "AAPL" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/Price" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/market/candles": {
      "get": {
        "tags": ["Market"],
        "summary": "OHLC candles aggregated on-read from tick history",
        "parameters": [
          { "name": "symbol", "in": "query", "required": true, "schema": { "type": "string" }, "example": "AAPL" },
          { "name": "interval", "in": "query", "required": false, "schema": { "type": "integer", "default": 15 }, "description": "Bucket size in seconds" },
          { "name": "from", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/Candles" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/leaderboard": {
      "get": {
        "tags": ["Leaderboard"],
        "summary": "Users ranked by total equity (equivalently ROI)",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "results": { "type": "integer" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/LeaderboardEntry" } }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "UP",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "UP" },
                    "message": { "type": "string", "example": "Trading engine is running." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["System"],
        "summary": "This OpenAPI document",
        "responses": { "200": { "description": "OpenAPI 3.1 spec" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Money": {
        "type": "string",
        "description": "Decimal string at 4 dp (DECIMAL(15,4))",
        "example": "195.0000"
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": { "type": "string", "maxLength": 50, "example": "trader1" },
          "email": { "type": "string", "format": "email", "example": "trader1@example.com" },
          "password": { "type": "string", "minLength": 8, "example": "password123" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "trader1@example.com" },
          "password": { "type": "string", "example": "password123" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": {
            "type": "object",
            "properties": {
              "user": { "$ref": "#/components/schemas/User" },
              "token": { "type": "string", "description": "JWT bearer token (HS256, 7-day expiry)" }
            }
          }
        }
      },
      "PlaceOrderRequest": {
        "type": "object",
        "required": ["symbol", "side", "quantity"],
        "properties": {
          "symbol": { "type": "string", "example": "AAPL" },
          "side": { "$ref": "#/components/schemas/Side" },
          "quantity": { "type": "number", "exclusiveMinimum": 0, "example": 2 },
          "orderType": { "$ref": "#/components/schemas/OrderType" },
          "targetPrice": { "$ref": "#/components/schemas/Money", "description": "Required for LIMIT, must be omitted for MARKET" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "WalletResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "data": { "$ref": "#/components/schemas/Wallet" }
        }
      },
      "Wallet": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "balance": { "$ref": "#/components/schemas/Money" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Position": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "quantity": { "$ref": "#/components/schemas/Money" },
          "averageBuyPrice": { "$ref": "#/components/schemas/Money" },
          "currentPrice": { "oneOf": [{ "$ref": "#/components/schemas/Money" }, { "type": "null" }] },
          "marketValue": { "oneOf": [{ "$ref": "#/components/schemas/Money" }, { "type": "null" }] },
          "costBasis": { "$ref": "#/components/schemas/Money" },
          "unrealizedPnl": { "oneOf": [{ "$ref": "#/components/schemas/Money" }, { "type": "null" }] },
          "unrealizedPnlPct": { "oneOf": [{ "$ref": "#/components/schemas/Money" }, { "type": "null" }] }
        }
      },
      "Portfolio": {
        "type": "object",
        "properties": {
          "cashBalance": { "$ref": "#/components/schemas/Money" },
          "holdingsValue": { "$ref": "#/components/schemas/Money" },
          "totalEquity": { "$ref": "#/components/schemas/Money" },
          "totalCostBasis": { "$ref": "#/components/schemas/Money" },
          "totalUnrealizedPnl": { "$ref": "#/components/schemas/Money" },
          "totalUnrealizedPnlPct": { "$ref": "#/components/schemas/Money" },
          "roiPct": { "$ref": "#/components/schemas/Money" },
          "startingCapital": { "$ref": "#/components/schemas/Money" },
          "unpricedSymbols": { "type": "array", "items": { "type": "string" } },
          "positions": { "type": "array", "items": { "$ref": "#/components/schemas/Position" } }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "symbol": { "type": "string" },
          "order_type": { "$ref": "#/components/schemas/OrderType" },
          "side": { "$ref": "#/components/schemas/Side" },
          "quantity": { "$ref": "#/components/schemas/Money" },
          "target_price": { "oneOf": [{ "$ref": "#/components/schemas/Money" }, { "type": "null" }] },
          "status": { "$ref": "#/components/schemas/OrderStatus" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Price": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "price": { "$ref": "#/components/schemas/Money" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Candles": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "intervalSec": { "type": "integer" },
          "candles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": { "type": "string", "format": "date-time" },
                "open": { "$ref": "#/components/schemas/Money" },
                "high": { "$ref": "#/components/schemas/Money" },
                "low": { "$ref": "#/components/schemas/Money" },
                "close": { "$ref": "#/components/schemas/Money" }
              }
            }
          }
        }
      },
      "LeaderboardEntry": {
        "type": "object",
        "properties": {
          "rank": { "type": "integer" },
          "userId": { "type": "string", "format": "uuid" },
          "username": { "type": "string" },
          "totalEquity": { "$ref": "#/components/schemas/Money" },
          "roiPct": { "$ref": "#/components/schemas/Money" },
          "hasUnpricedHoldings": { "type": "boolean" }
        }
      },
      "ResetSummary": {
        "type": "object",
        "properties": {
          "wallet": { "$ref": "#/components/schemas/Wallet" },
          "positionsLiquidated": { "type": "integer" },
          "ordersCancelled": { "type": "integer" },
          "resetTransactions": { "type": "array", "items": { "type": "object" } }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["fail", "error"] },
          "message": { "type": "string" }
        }
      },
      "Side": { "type": "string", "enum": ["BUY", "SELL"] },
      "OrderType": { "type": "string", "enum": ["MARKET", "LIMIT"] },
      "OrderStatus": { "type": "string", "enum": ["PENDING", "FILLED", "CANCELLED", "REJECTED"] },
      "TransactionType": { "type": "string", "enum": ["BUY", "SELL", "DEPOSIT", "RESET"] }
    },
    "responses": {
      "ValidationError": {
        "description": "Validation error (bad/missing fields, bad UUID)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Missing/invalid/expired token or bad credentials",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "Conflict (duplicate email/username, or non-pending order)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BusinessRule": {
        "description": "Business rule violation (insufficient funds/holdings, unpriced asset)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
