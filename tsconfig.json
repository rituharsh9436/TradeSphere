{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "target": "esnext",
    "module": "commonjs",     // Changed from nodenext for easier Express compatibility
    "esModuleInterop": true,  // Added for compatibility with older Node libraries
    
    // For nodejs:
    "types": ["node"],        // Added to ensure Node.js types are loaded

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}