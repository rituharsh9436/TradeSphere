# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/tradesphere
PORT=5000

# Set to "production" when deploying. This drops the legacy /api/users and
# /api/orders dev routes (which trust a client-supplied userId) so only the
# token-authenticated /api/me/* surface is exposed, and makes JWT_SECRET
# mandatory (the server refuses to sign tokens with the insecure dev fallback).
NODE_ENV=development

# Number of reverse proxies in front of the app (Express "trust proxy"). Required
# for correct client IPs / rate limiting when behind a load balancer or CDN.
# Defaults to 1 in production and off otherwise; set explicitly to match your infra.
# TRUST_PROXY=1

# Comma-separated allowlist of browser origins permitted via CORS. When unset, any
# origin is reflected (fine for local dev). Set to your frontend origin(s) in prod.
# CORS_ORIGIN=https://app.example.com

# How often (ms) to re-check US market hours and switch the tick source between the
# live Finnhub feed and the simulator. Default 60000 (1 min).
# MARKET_MODE_RESYNC_MS=60000

# --- Auth (Step 10) ---
# Secret used to sign JWT auth tokens (HS256). REQUIRED in production; if unset,
# the server falls back to an insecure dev secret and logs a one-time warning.
JWT_SECRET=change-me-to-a-long-random-string

# --- Registration email OTP (Brevo) ---
# We use the Brevo Transactional Email API to send OTP emails.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM_EMAIL=no-reply@mydomain.com
MAIL_FROM_NAME=TradeSphere
# Optional separate key for hashing OTPs; defaults to JWT_SECRET when unset.
# OTP_SECRET=change-me-to-a-different-long-random-string

# --- Market data (Step 6a) ---
# Finnhub real-time trades WebSocket. Leave UNSET to use the simulated feed
# (also used automatically outside US market hours). Get a free key at
# https://finnhub.io/register
FINNHUB_API_KEY=

# Simulator tick cadence in ms (default 2000).
MARKET_TICK_INTERVAL_MS=2000
# Default candlestick bucket in seconds (the /candles endpoint accepts any value).
MARKET_DEFAULT_CANDLE_SEC=15
# Minimum gap between DB writes per symbol in ms (throttles a busy live feed).
MARKET_HISTORY_THROTTLE_MS=1000
